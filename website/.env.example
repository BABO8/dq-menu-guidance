# ==============================================================================
# Menu Price Guide - Production & Staging Environment Variables
# Copy this file to .env and configure values for your deployment environment.
# ==============================================================================

# Environment mode: 'development', 'staging', or 'production'
ENVIRONMENT=production

# Debug mode: True in local development; MUST be False in production
DEBUG=False

# Canonical public HTTPS URL of the website
# In production, replace with your confirmed production domain (e.g. https://www.yourdomain.com)
SITE_URL=https://your-production-domain.com

# Cryptographic secret key used for session signing and CSRF tokens
# REQUIRED IN PRODUCTION: Must be at least 32 characters, randomly generated.
# Generate one by running: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars-long

# Administrator Credentials (used for initial setup & admin login)
ADMIN_USERNAME=editorial_admin
ADMIN_PASSWORD=DqPriceGuide2026!Admin
ADMIN_INITIAL_PASSWORD=DqPriceGuide2026!Admin

# Google AdSense Publisher ID (used for dynamic /ads.txt generation)
# Replace with your verified Google AdSense publisher ID
ADSENSE_PUB_ID=pub-0000000000000000

# Cookie Security & SSL Configuration
# Set to True in production to enforce the Secure flag on all session and CSRF cookies
COOKIE_SECURE=True

# Allowed Host headers (comma-separated). In production, specify exact domains:
ALLOWED_HOSTS=your-production-domain.com,www.your-production-domain.com,localhost,127.0.0.1

# SQLite Database path (defaults to ./data/dq_guide.db)
DATABASE_PATH=data/dq_guide.db

# Administrator Session Expiry in hours (default: 8 hours)
ADMIN_SESSION_EXPIRY_HOURS=8

# Optional SMTP Email Configuration (if enabling external mail delivery for contact form)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
# SMTP_FROM=editor@menupriceguide.com
